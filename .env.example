# =============================================================================
# StreamClick — variables de entorno
# =============================================================================
# Copia este archivo a .env.local y complétalo.
# Todas se validan con zod al arrancar (src/lib/env.ts): si falta alguna, el
# proceso falla en el build y no seis horas después, cuando llegue el primer
# correo y el webhook descubra que no puede escribir en la base de datos.
# =============================================================================

# --- Supabase ----------------------------------------------------------------
# Panel de Supabase → Project Settings → API

NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co

# Clave pública. Es segura en el navegador PORQUE RLS está activo en todas las
# tablas: sin políticas que lo permitan, esta clave no lee nada.
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# ⚠️ OMITE ROW LEVEL SECURITY POR COMPLETO.
# Sólo la usa el webhook de ingesta. Nunca debe llegar al navegador ni al
# control de versiones: filtrarla equivale a entregar la base de datos entera.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# --- Webhook de correo entrante ----------------------------------------------
# Secreto compartido con el proveedor (Resend, Postmark, Cloudflare…) para
# verificar la firma HMAC. Sin él, cualquiera podría inyectar PIN falsos.
# Generar con:  openssl rand -hex 32
INBOUND_EMAIL_WEBHOOK_SECRET=

# --- Cifrado de credenciales -------------------------------------------------
# Clave AES-256-GCM: exactamente 32 bytes en hexadecimal (64 caracteres).
# Generar con:  openssl rand -hex 32
#
# ⚠️ Rotarla deja ilegibles las contraseñas ya almacenadas. No hay migración
# automática: habría que descifrar con la clave antigua y volver a cifrar.
# Ver docs/adr/0007 para el alcance real de esta protección.
CREDENTIALS_ENCRYPTION_KEY=

# --- Aplicación ---------------------------------------------------------------
# URL pública. La usan los enlaces de confirmación de correo: si apunta a
# localhost en producción, los usuarios no podrán activar su cuenta.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
