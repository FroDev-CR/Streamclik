# =============================================================================
# StreamClick — variables de entorno
# =============================================================================
# Copia este archivo a .env.local y complétalo.
# Todas se validan con zod al arrancar (src/lib/env.ts): si falta alguna, el
# proceso falla en el build y no seis horas después, cuando llegue el primer
# correo y el webhook descubra que no puede escribir en la base de datos.
# =============================================================================

# --- Supabase ----------------------------------------------------------------
# Panel de Supabase → Project Settings → API

NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co

# Clave pública. Es segura en el navegador PORQUE RLS está activo en todas las
# tablas: sin políticas que lo permitan, esta clave no lee nada.
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# ⚠️ OMITE ROW LEVEL SECURITY POR COMPLETO.
# Sólo la usa el webhook de ingesta. Nunca debe llegar al navegador ni al
# control de versiones: filtrarla equivale a entregar la base de datos entera.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# --- Webhook de correo entrante ----------------------------------------------
# Secreto compartido con el proveedor (Resend, Postmark, Cloudflare…) para
# verificar la firma HMAC. Sin él, cualquiera podría inyectar PIN falsos.
# Generar con:  openssl rand -hex 32
INBOUND_EMAIL_WEBHOOK_SECRET=

# --- Cifrado de credenciales -------------------------------------------------
# Clave AES-256-GCM: exactamente 32 bytes en hexadecimal (64 caracteres).
# Generar con:  openssl rand -hex 32
#
# ⚠️ Rotarla deja ilegibles las contraseñas ya almacenadas. No hay migración
# automática: habría que descifrar con la clave antigua y volver a cifrar.
# Ver docs/adr/0007 para el alcance real de esta protección.
CREDENTIALS_ENCRYPTION_KEY=

# --- Correo de entrega (Resend) ----------------------------------------------
# Resend -> API Keys -> Create API Key. Usa una clave con permiso de envío.
# Nunca uses esta variable con prefijo NEXT_PUBLIC_: debe existir sólo en el
# servidor y también debe agregarse en Vercel para Production y Preview.
RESEND_API_KEY=re_...

# El dominio debe estar verificado en Resend. La dirección no necesita un buzón
# creado, aunque conviene que pueda recibir respuestas de los clientes.
RESEND_FROM_EMAIL=cuentas@streamclick.xyz

# --- Clerk (autenticación) -----------------------------------------------------
# Clerk emite la identidad; Supabase la valida contra su JWKS y RLS decide qué
# devuelve (ADR-0008). Panel de Clerk → API Keys.
#
# ⚠️ Las lee `clerkMiddleware()`, que se ejecuta ANTES que cualquier código de la
# aplicación. Si faltan, el build pasa sin quejarse y cada petición muere con
# MIDDLEWARE_INVOCATION_FAILED, sin ninguna pista de cuál es la variable que
# falta. Al desplegar hay que cargarlas en el panel del hosting, no sólo aquí.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# --- Aplicación ---------------------------------------------------------------
# URL pública. La usan los enlaces de confirmación de correo: si apunta a
# localhost en producción, los usuarios no podrán activar su cuenta.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- GoPlay (proveedor de las cuentas de Disney+) ------------------------------
# Opcional. Sin esto, la app funciona pero no puede consultar el código de las
# cuentas compradas a GoPlay; la pantalla lo indica en vez de fallar.
#
# Con email y contraseña el servidor inicia sesión solo y renueva el token
# cuando caduca. Sólo funciona mientras la cuenta NO tenga Google Authenticator
# activo: con 2FA hay que pegar un token vigente en GOPLAY_TOKEN.
GOPLAY_BASE_URL=https://api.goplay.com.co
# Tu subdominio en GoPlay. Viaja como cabecera Origin: su backend la exige.
GOPLAY_ORIGIN=https://mypantalla.goplay.com.co
GOPLAY_EMAIL=
GOPLAY_PASSWORD=
GOPLAY_TOKEN=
